# Vote Without Doubt - root .gitignore
# Academic prototype. Local-only repository. No remote is configured.

# ---------------------------------------------------------------------------
# Secrets / local configuration (NEVER commit real secrets)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/node_modules/**/fixtures/*.key
secrets/
*.secret

# ---------------------------------------------------------------------------
# Python / Flask backend
# ---------------------------------------------------------------------------
backend/venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.log

# ---------------------------------------------------------------------------
# Node / Vite frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Blockchain / Hardhat
# ---------------------------------------------------------------------------
blockchain/node_modules/
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
blockchain/typechain/
blockchain/deployments/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Local databases / dumps (never commit voter data)
# ---------------------------------------------------------------------------
*.sql.gz
*.dump
*.ibd
data/
instance/
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Local subsystem backups & temporary scratch files
# ---------------------------------------------------------------------------
.backups/
*.bak
*.bak.*
*.fix2.bak
scratch/
backend/scratch/
.freebuff/
backend/benchmark_results/
backend/face_models/
blockchain/.hardhat_data/
VWD_Report_Evidence/

# ---------------------------------------------------------------------------
# Internal audit reconnaissance transcripts & developer diagnostic probes
# ---------------------------------------------------------------------------
COMPREHENSIVE_RECONNAISSANCE.md
FINAL_RECONNAISSANCE_REPORT.md
RECONNAISSANCE_REPORT.md
VWD_COMPLETE_REPOSITORY_INVESTIGATION.md
backend/probe_face.py
blockchain/deferred_phase9/
docs/PHASE6_GANACHE_PROOF.txt

# ---------------------------------------------------------------------------
# Runtime uploaded candidate media (sample assets remain in frontend/public)
# ---------------------------------------------------------------------------
backend/app/uploads/
