# Vote Without Doubt - frontend environment
#
# Copy to `.env.local` (git-ignored) and adjust. Never commit real values.
#
# Base URL for all backend calls. The default is the relative path `/api`:
#   - in development, `vite.config.js` proxies `/api` to VITE_DEV_API_TARGET;
#   - in production, the same relative path works behind a reverse proxy.
# Set an absolute origin (e.g. https://api.example.com/api) only when the
# backend is on a different origin, and ensure the backend CORS allow-list and
# cookie policy permit it.
VITE_API_BASE_URL=/api

# Development-only: where the Vite dev server proxies /api requests.
VITE_DEV_API_TARGET=http://127.0.0.1:5000