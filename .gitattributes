# Normalise line endings so the repository is deterministic across platforms.
* text=auto eol=lf

*.md    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.sol   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

*.png   binary
*.jpg   binary
*.svg   text eol=lf