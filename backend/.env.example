# Vote Without Doubt - Backend Environment Variables
# This file contains placeholder values only. DO NOT put real secrets here.

# Flask Configuration
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Phase 2 OTP pepper (REQUIRED in production - the app refuses to boot without it)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this value invalidates every OTP issued under the old pepper.
OTP_PEPPER=

# Phase 3 electoral-roll bootstrap credential (REQUIRED in production).
# Sent as the X-Admin-Token header by the roll-import tooling only.
# This is deliberately NOT the Phase 11 RBAC subsystem: it exists so the
# authoritative electoral roll cannot be modified anonymously. Phase 11 replaces
# it with real election-officer roles and four-eyes approval.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ROLL_ADMIN_TOKEN=

# Application Configuration
APP_NAME=Vote Without Doubt
APP_ENV=development
APP_DEBUG=False

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=voting_sys
MYSQL_USER=voting_sys_user
MYSQL_PASSWORD=your-database-password-here
MYSQL_ROOT_PASSWORD=your-root-password-here

# Database Connection Pool (Optional)
DB_POOL_SIZE=5
DB_POOL_RECYCLE=3600

# Email Configuration (SMTP/Mailpit for development)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@votewithoutdoubt.local

# Blockchain Configuration (Ganache - Development Only)
GANACHE_HOST=localhost
GANACHE_PORT=8545
GANACHE_CHAIN_ID=1337

# Relayer Configuration (Future Phase)
RELAYER_ENABLED=False

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
# The in-process limiter is enabled by default; the store must be replaced with a
# shared backend (e.g. Redis) before running multiple workers.
RATE_LIMIT_ENABLED=True
# Admin API rate limiting toggle (development convenience; defaults to True, production requires True)
ADMIN_RATE_LIMIT_ENABLED=True

# Phase 8: Per-election pseudonym master encryption key (REQUIRED in production).
# Protects per-election pseudonym keys in the database using Fernet authenticated envelope encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PSEUDONYM_MASTER_KEY=

# Phase 5: Biometric ArcFace template encryption key (REQUIRED in production).
# Protects facial embedding templates at rest using Fernet authenticated envelope encryption (AES-128-CBC + HMAC-SHA256).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_ENCRYPTION_KEY=

# Security Notes:
# - Never commit real secrets to version control
# - Use strong, random values in actual .env
# - This is for local development only
# - Rotate secrets if exposed
# - OTP_PEPPER, SECRET_KEY, PSEUDONYM_MASTER_KEY, and FACE_ENCRYPTION_KEY have no production fallback; the app fails closed